---
// The signature moment: a pinned stage where the cone is built scoop by scoop while the page scrolls.
// With motion: the track is tall, the stage sticks and src/scripts/motion.ts scrubs a rendered frame sequence
// (public/cone/, made in blender-projects/gelato-brand-website) on the canvas; the background takes the flavour's colour.
// Without motion (or without JavaScript): the finished cone next to the list of all six flavours.
import { Image } from "astro:assets";
import { flavours, hero } from "@/content/site";
import { withBase } from "@/lib/url";

const count = flavours.items.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section
  id="flavours"
  class="flavours"
  aria-labelledby="flavours-title"
  data-flavours
  style={`--steps:${count}`}
>
  <div class="flavours__track" data-flavours-track>
    <div class="flavours__stage" data-flavours-stage>
      <div class="container-page flavours__grid">
        <header class="flavours__head">
          <p class="eyebrow">{flavours.eyebrow}</p>
          <h2 id="flavours-title" class="flavours__title">
            {flavours.title}
          </h2>
          <p class="lead flavours__lead">{flavours.lead}</p>
        </header>

        <div class="flavours__visual">
          <div class="flavours__disc" aria-hidden="true"></div>
          <div
            class="flavours__cone"
            data-cone
            data-frames={flavours.frames.count}
            data-frames-src={withBase(flavours.frames.path)}
          >
            <Image
              class="flavours__still"
              src={hero.image}
              alt="The finished cone: raspberry, salted caramel, mint, mango and pistachio under fior di latte"
              widths={[220, 330, 445]}
              sizes="(min-width: 1024px) 320px, 45vw"
              format="webp"
              quality={80}
              loading="lazy"
            />
            <canvas class="flavours__canvas" aria-hidden="true" data-cone-canvas></canvas>
          </div>
        </div>

        <ol class="flavours__items">
          {flavours.items.map((item, i) => (
            <li
              class="flavours__item"
              data-flavour={i}
              data-colour={item.colour}
              data-active={i === 0 ? "" : undefined}
            >
              <span class="flavours__num" aria-hidden="true">
                {pad(i + 1)} / {pad(count)}
              </span>
              <span class="flavours__dot" style={`background:${item.colour}`} aria-hidden="true" />
              <h3 class="flavours__name">{item.name}</h3>
              <p class="flavours__note">{item.note}</p>
            </li>
          ))}
        </ol>

        <ul class="flavours__progress" aria-hidden="true">
          {flavours.items.map((item, i) => (
            <li data-progress={i}>
              <span style={`background:${item.colour}`} />
              {item.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Static layout (reduced motion, no JavaScript) ---------- */
  .flavours {
    --bg: var(--color-cream-deep);
    background: var(--bg);
    transition: background-color 0.7s var(--ease-out-soft);
  }

  .flavours__stage {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .flavours__grid {
    display: grid;
    gap: 2.5rem;
  }

  .flavours__title {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 5.4vw, 4.5rem);
    max-width: 14ch;
  }

  .flavours__lead {
    max-width: 30rem;
    margin-top: 1.25rem;
  }

  .flavours__visual {
    position: relative;
    display: grid;
    place-items: center;
  }

  .flavours__disc {
    position: absolute;
    width: min(100%, 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
  }

  .flavours__cone {
    position: relative;
    display: grid;
    width: clamp(7rem, 20vw, 11rem);
    filter: drop-shadow(0 30px 30px rgb(80 30 40 / 0.22));
  }

  .flavours__cone :global(img),
  .flavours__canvas {
    grid-area: 1 / 1;
    width: 100%;
  }

  .flavours__canvas {
    display: none;
  }

  .flavours__items {
    display: grid;
    gap: 0.25rem;
    counter-reset: flavour;
  }

  .flavours__item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(42 26 31 / 0.12);
  }

  .flavours__num {
    display: none;
  }

  .flavours__dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px rgb(42 26 31 / 0.25);
    translate: 0 0.1rem;
  }

  .flavours__name {
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .flavours__note {
    grid-column: 2;
    margin-top: 0.35rem;
    color: var(--color-cocoa-soft);
  }

  .flavours__progress {
    display: none;
  }

  @media (min-width: 1024px) {
    .flavours__grid {
      grid-template-columns: 1fr minmax(16rem, 22rem) 1fr;
      grid-template-areas: "head head head" "cone cone items";
      align-items: center;
    }

    .flavours__head {
      grid-area: head;
    }

    .flavours__visual {
      grid-area: cone;
    }

    .flavours__items {
      grid-area: items;
    }
  }

  /* ---------- Scroll story (motion allowed, set before the first paint) ---------- */
  :global(.motion) .flavours__track {
    height: calc(var(--steps) * 70svh + 100svh);
  }

  :global(.motion) .flavours__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    padding-block: calc(var(--header-h) + 0.5rem) 1.5rem;
    overflow: clip;
  }

  :global(.motion) .flavours__grid {
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 1rem;
  }

  /* The frames are 1 : 2; the box gets a fixed size so the canvas and the still line up exactly. */
  :global(.motion) .flavours__cone {
    --cone-h: min(100%, 50svh, 30rem);
    display: block;
    height: var(--cone-h);
    width: auto;
    aspect-ratio: 1 / 2;
  }

  :global(.motion) .flavours__canvas,
  :global(.motion) .flavours__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.4s;
  }

  :global(.motion) .flavours__canvas {
    display: block;
    opacity: 0;
  }

  :global(.motion) .flavours__still {
    object-fit: contain;
    object-position: 50% 100%;
    padding-top: 6%;
  }

  :global(.motion) .flavours__cone[data-ready] .flavours__canvas {
    opacity: 1;
  }

  :global(.motion) .flavours__cone[data-ready] .flavours__still {
    opacity: 0;
  }

  :global(.motion) .flavours__visual {
    min-height: 0;
    height: 100%;
  }

  :global(.motion) .flavours__disc {
    width: min(100%, 62svh);
  }

  :global(.motion) .flavours__items {
    display: grid;
    gap: 0;
  }

  :global(.motion) .flavours__dot {
    display: none;
  }

  :global(.motion) .flavours__note {
    grid-column: 1 / -1;
    max-width: 24rem;
  }

  :global(.motion) .flavours__item {
    grid-area: 1 / 1;
    grid-template-columns: 1fr;
    border: 0;
    padding: 0;
    opacity: 0;
    translate: 0 1.25rem;
    transition:
      opacity 0.35s,
      translate 0.5s var(--ease-out-soft);
  }

  :global(.motion) .flavours__item[data-active] {
    opacity: 1;
    translate: 0 0;
  }

  :global(.motion) .flavours__num {
    display: block;
    grid-column: 1 / -1;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-raspberry-deep);
  }

  :global(.motion) .flavours__name {
    font-size: clamp(2rem, 4.6vw, 3.75rem);
  }

  @media (max-width: 1023px) {
    :global(.motion) .flavours__title {
      font-size: clamp(1.9rem, 8vw, 2.6rem);
    }

    :global(.motion) .flavours__lead {
      display: none;
    }

    :global(.motion) .flavours__item {
      text-align: left;
    }
  }

  @media (min-width: 1024px) {
    :global(.motion) .flavours__grid {
      grid-template-columns: 1fr minmax(14rem, 24rem) 1fr;
      grid-template-rows: 1fr;
      grid-template-areas: "head cone progress" "items cone progress";
      align-items: center;
      gap: 0 3rem;
    }

    :global(.motion) .flavours__head {
      align-self: end;
    }

    :global(.motion) .flavours__items {
      grid-area: items;
      align-self: start;
      margin-top: 2.5rem;
    }

    :global(.motion) .flavours__visual {
      grid-area: cone;
      grid-row: 1 / -1;
    }

    :global(.motion) .flavours__cone {
      height: min(44rem, 82svh);
    }

    :global(.motion) .flavours__progress {
      grid-area: progress;
      grid-row: 1 / -1;
      justify-self: end;
      display: grid;
      gap: 0.85rem;
      font-weight: 600;
      color: var(--color-cocoa-soft);
    }

    :global(.motion) .flavours__progress li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      transition:
        color 0.3s,
        translate 0.4s var(--ease-out-soft);
    }

    :global(.motion) .flavours__progress li[data-done] {
      color: var(--color-cocoa);
    }

    :global(.motion) .flavours__progress li[data-current] {
      translate: -0.75rem 0;
      font-weight: 700;
    }

    :global(.motion) .flavours__progress li[data-current] span {
      scale: 1.5;
    }

    :global(.motion) .flavours__progress span {
      width: 0.85rem;
      height: 0.85rem;
      border-radius: 50%;
      box-shadow: inset 0 0 0 1.5px rgb(42 26 31 / 0.3);
    }
  }
</style>
