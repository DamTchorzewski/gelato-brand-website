---
// The three product lines as large cards that stack on top of each other while scrolling (CSS sticky, no script).
// "More about" opens a native <dialog> with the details.
import { Image } from "astro:assets";
import { menu } from "@/content/site";
import Icon from "@/components/Icon.astro";
---

<section id="menu" class="section menu" aria-labelledby="menu-title">
  <div class="container-page">
    <header class="menu__head">
      <p class="eyebrow">{menu.eyebrow}</p>
      <h2 id="menu-title" class="display mt-4">
        {menu.title}
      </h2>
    </header>

    <ul class="menu__stack">
      {menu.items.map((item, i) => (
        <li class="menu__slot" style={`--i:${i}`}>
          <article class="menu__card" style={`--card:${item.colour}`} data-menu-card>
            <div class="menu__media">
              <Image
                src={item.image}
                alt={item.alt}
                widths={[320, 480, 670]}
                sizes="(min-width: 1024px) 480px, 80vw"
                format="webp"
                quality={80}
              />
            </div>
            <div class="menu__body">
              <span class="menu__index" aria-hidden="true">
                0{i + 1}
              </span>
              <h3 class="menu__name">{item.name}</h3>
              <p class="menu__lead">{item.lead}</p>
              <div class="menu__foot">
                <p class="menu__price">{item.price}</p>
                <button
                  type="button"
                  class="btn btn-ghost"
                  aria-haspopup="dialog"
                  aria-controls={`dialog-${item.id}`}
                  data-dialog-open={`dialog-${item.id}`}
                >
                  More about {item.name.toLowerCase()}
                  <Icon name="arrow" size={18} />
                </button>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>

  {menu.items.map((item) => (
    <dialog id={`dialog-${item.id}`} class="modal" aria-labelledby={`dialog-${item.id}-title`}>
      <div class="modal__band" style={`background:${item.colour}`}>
        <Image
          src={item.image}
          alt=""
          widths={[240, 360]}
          sizes="180px"
          format="webp"
          quality={75}
          class="modal__img"
        />
        <button type="button" class="icon-btn modal__close" data-dialog-close>
          <Icon name="close" size={20} />
          <span class="sr-only">Close</span>
        </button>
      </div>
      <div class="p-6 sm:p-8">
        <h3 id={`dialog-${item.id}-title`} class="text-4xl">
          {item.name}
        </h3>
        <p class="mt-3 text-[var(--color-cocoa-soft)]">{item.lead}</p>
        <ul class="modal__list">
          {item.details.map((detail) => (
            <li>
              <Icon name="leaf" size={18} />
              {detail}
            </li>
          ))}
        </ul>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <p class="menu__price">{item.price}</p>
          <a class="btn btn-primary" href="#shops" data-dialog-close>
            Find a shop
            <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .menu__head {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .menu__stack {
    display: grid;
    gap: 1.5rem;
  }

  .menu__card {
    display: grid;
    overflow: hidden;
    border-radius: 2rem;
    background: var(--card);
    box-shadow: 0 30px 60px -40px rgb(42 26 31 / 0.5);
    transform-origin: 50% 0;
  }

  .menu__media {
    display: grid;
    place-items: center;
    padding: 2rem 2rem 0;
  }

  .menu__media :global(img) {
    width: min(100%, 22rem);
    filter: drop-shadow(0 24px 24px rgb(42 26 31 / 0.2));
  }

  .menu__body {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
  }

  .menu__index {
    font-weight: 700;
    letter-spacing: 0.14em;
    font-size: 0.8125rem;
    color: var(--color-raspberry-deep);
  }

  .menu__name {
    margin-top: 0.5rem;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
  }

  .menu__lead {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 1.0625rem;
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .menu__price {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
  }

  @media (min-width: 768px) {
    .menu__stack {
      gap: 0;
    }

    .menu__slot {
      position: sticky;
      top: calc(var(--header-h) + 1rem + var(--i) * 1.5rem);
      padding-bottom: 2rem;
    }

    .menu__slot:not(:last-child) {
      padding-bottom: 12vh;
    }

    .menu__card {
      grid-template-columns: 1fr 1.1fr;
      min-height: min(34rem, 70svh);
    }

    .menu__media {
      padding: 2.5rem;
    }

    .menu__body {
      padding: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .modal__band {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }

  .modal__img {
    width: 11rem;
  }

  .modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .modal__list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .modal__list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .modal__list :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--color-raspberry-deep);
  }
</style>
