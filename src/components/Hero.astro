---
// First screen: the promise in big type, the cone, two actions and the size of the brand.
import { Image } from "astro:assets";
import { hero } from "@/content/site";
import Icon from "@/components/Icon.astro";
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container-page hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-hero-fade>
        {hero.eyebrow}
      </p>
      <h1 id="hero-title" class="hero__title">
        {hero.title.map((line) => (
          <span class="hero__line">{line}</span>
        ))}
        <span class="hero__line hero__accent">{hero.accent}</span>
      </h1>
      <p class="lead hero__lead" data-hero-fade>
        {hero.lead}
      </p>
      <div class="hero__actions" data-hero-fade>
        <a class="btn btn-primary" href={hero.primary.href}>
          {hero.primary.label}
          <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
      <dl class="hero__stats" data-hero-fade>
        {hero.stats.map((stat) => (
          <div class="hero__stat">
            <dt class="sr-only">{stat.label}</dt>
            <dd>
              <span class="hero__stat-value">{stat.value}</span>
              <span class="hero__stat-label">{stat.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__visual">
      <div class="hero__disc" aria-hidden="true" data-parallax="-0.12"></div>
      <span class="hero__blob hero__blob--mint" aria-hidden="true" data-parallax="0.35"></span>
      <span class="hero__blob hero__blob--mango" aria-hidden="true" data-parallax="-0.3"></span>
      <span class="hero__blob hero__blob--berry" aria-hidden="true" data-parallax="0.2"></span>
      <div class="hero__cone" data-hero-cone>
        <Image
          src={hero.image}
          alt={hero.alt}
          widths={[220, 330, 445]}
          sizes="(min-width: 1024px) 300px, (min-width: 640px) 26vw, 32vw"
          loading="eager"
          fetchpriority="high"
          format="webp"
          quality={82}
        />
      </div>
      <p class="hero__sticker" aria-hidden="true" data-parallax="0.18">
        <span>Sooo</span>
        <span>tasty!</span>
      </p>
    </div>
  </div>

  <a class="hero__cue" href="#flavours">
    <span>Scroll to build a cone</span>
    <Icon name="down" size={18} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem));
    padding-bottom: 5rem;
    background:
      radial-gradient(60% 50% at 85% 30%, rgb(255 211 221 / 0.75), transparent 70%),
      radial-gradient(40% 40% at 0% 100%, rgb(255 217 166 / 0.45), transparent 70%),
      var(--color-cream);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__title {
    margin-top: 1.25rem;
    font-size: clamp(3.4rem, 10.5vw, 8.4rem);
    line-height: 0.88;
  }

  .hero__line {
    display: block;
  }

  .hero__accent {
    font-style: italic;
    font-weight: 700;
    color: var(--color-raspberry);
    font-variation-settings:
      "SOFT" 100,
      "WONK" 1;
    padding-bottom: 0.08em;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__stats {
    display: flex;
    gap: 2.5rem;
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    max-width: 30rem;
  }

  .hero__stat dd {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .hero__stat-value {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 100;
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--color-raspberry-deep);
  }

  .hero__stat-label {
    font-weight: 600;
    color: var(--color-cocoa-soft);
  }

  .hero__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(26rem, 70vw, 40rem);
  }

  .hero__disc {
    position: absolute;
    width: min(92%, 34rem, 66svh);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffe3ea, var(--color-candy) 75%);
    box-shadow: inset 0 -30px 60px rgb(211 19 66 / 0.15);
  }

  .hero__cone {
    position: relative;
    width: min(clamp(9rem, 26vw, 19rem), 23svh);
    filter: drop-shadow(0 40px 40px rgb(120 20 50 / 0.28));
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
  }

  .hero__blob--mint {
    width: 4.5rem;
    aspect-ratio: 1;
    top: 8%;
    left: 6%;
    background: radial-gradient(circle at 35% 30%, #e6fbef, #9fdcbc);
  }

  .hero__blob--mango {
    width: 3rem;
    aspect-ratio: 1;
    bottom: 14%;
    left: 14%;
    background: radial-gradient(circle at 35% 30%, #fff0d6, #ffb86b);
  }

  .hero__blob--berry {
    width: 2.25rem;
    aspect-ratio: 1;
    top: 18%;
    right: 8%;
    background: radial-gradient(circle at 35% 30%, #ffc0cf, var(--color-raspberry));
  }

  .hero__sticker {
    position: absolute;
    right: 2%;
    bottom: 16%;
    display: grid;
    place-content: center;
    width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-cocoa);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-variation-settings:
      "SOFT" 100,
      "WONK" 1;
    font-style: italic;
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
    text-align: center;
    rotate: -12deg;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-cocoa-soft);
    border-radius: 999px;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
      min-height: calc(100svh - var(--header-h) - 8rem);
    }

    .hero__sticker {
      width: 8.5rem;
      font-size: 1.55rem;
    }
  }

  /* Phone and tablet: the cone comes right after the headline, so the first screen shows the product. */
  @media (max-width: 1023px) {
    .hero__grid {
      gap: 0;
    }

    .hero__copy {
      display: contents;
    }

    .hero__title {
      order: 1;
    }

    .hero__visual {
      order: 2;
      min-height: 0;
      margin-top: 1rem;
      padding-block: 1rem;
    }

    .hero__cone {
      width: min(32vw, 21svh, 11.5rem);
    }

    .hero__disc {
      width: min(78vw, 24rem);
    }

    .hero__lead {
      order: 3;
    }

    .hero__actions {
      order: 4;
    }

    .hero__stats {
      order: 5;
    }

    .hero__cue {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .hero__stats {
      gap: 1.75rem;
    }

    .hero__sticker {
      width: 6rem;
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__cue :global(svg) {
      /* three nudges only: nothing moves by itself for longer than 5 s */
      animation: nudge 1.6s var(--ease-out-soft) 1s 3;
    }

    @keyframes nudge {
      0%,
      60%,
      100% {
        transform: translateY(0);
      }
      30% {
        transform: translateY(5px);
      }
    }
  }
</style>
