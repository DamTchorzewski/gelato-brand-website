---
// The brand lockup: a scoop-on-a-cone mark and the name set in the display face (no image, so it is sharp at any size).
interface Props {
  class?: string;
  tone?: "dark" | "light";
}

const { class: className, tone = "dark" } = Astro.props;
---

<span class:list={["logo", tone === "light" && "logo--light", className]}>
  <svg viewBox="0 0 32 40" width="26" height="32" aria-hidden="true" focusable="false">
    <path d="M7 17h18l-9 21z" fill="#e9b778"></path>
    <path
      d="M10 21l9 7M14 18l8 7M9.5 24l5 4M17 18l5 4M21 20l-11 9M16 18l-7 6"
      stroke="#b7803f"
      stroke-width="1.2"
      stroke-linecap="round"
    ></path>
    <circle cx="16" cy="12" r="10" fill="currentColor"></circle>
    <circle cx="12" cy="9" r="2.4" fill="#fff" opacity=".55"></circle>
    <path
      d="M6.5 15.5c2 1.6 4 .4 5.5 1.8 1.6 1.4 3.4.2 5-.6 1.6-.8 3.2.9 4.8-.2 1.1-.8 2.4-.4 3.7-1"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      fill="none"
    ></path>
  </svg>
  <span class="logo__word">Velluto</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-raspberry);
  }

  .logo__word {
    font-family: var(--font-display);
    font-variation-settings:
      "SOFT" 100,
      "WONK" 1;
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: -0.03em;
    color: var(--color-cocoa);
  }

  .logo--light .logo__word {
    color: var(--color-cream);
  }

  .logo--light {
    color: var(--color-candy);
  }
</style>
