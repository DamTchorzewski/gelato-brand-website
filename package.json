{
  "name": "gelato-brand-website",
  "version": "1.0.0",
  "description": "Scroll-driven website of a gelato brand, built with Astro, Tailwind CSS and GSAP.",
  "author": "DamReboot IT Damian Chabracki",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://damtchorzewski.github.io/gelato-brand-website/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamTchorzewski/gelato-brand-website.git"
  },
  "bugs": {
    "url": "https://github.com/DamTchorzewski/gelato-brand-website/issues"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "health": "node scripts/health.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
